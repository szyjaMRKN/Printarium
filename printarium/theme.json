{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "820px",
			"wideSize": "1280px"
		},
		"color": {
			"custom": true,
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "tlo", "color": "#07110D", "name": "Tło" },
				{ "slug": "powierzchnia", "color": "#0D1913", "name": "Powierzchnia" },
				{ "slug": "zielen", "color": "#829B2F", "name": "Zieleń" },
				{ "slug": "tekst", "color": "#F3F4EF", "name": "Tekst" },
				{ "slug": "pomocniczy", "color": "#9CA59E", "name": "Pomocniczy" },
				{ "slug": "blad", "color": "#D65C5C", "name": "Błąd" },
				{ "slug": "sukces", "color": "#6BAB6B", "name": "Sukces" }
			]
		},
		"typography": {
			"customFontSize": true,
			"fontSizes": [
				{ "slug": "caption", "size": "0.75rem", "name": "Caption" },
				{ "slug": "label", "size": "0.875rem", "name": "Label" },
				{ "slug": "body", "size": "1rem", "name": "Body" },
				{ "slug": "h3", "size": "1.5rem", "name": "H3" },
				{ "slug": "h2", "size": "2rem", "name": "H2" },
				{ "slug": "h1", "size": "4rem", "name": "H1" }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vh", "vw" ]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--tlo)",
			"text": "var(--wp--preset--color--tekst)"
		},
		"typography": {
			"fontFamily": "\"Montserrat\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Arial, sans-serif",
			"fontSize": "1rem",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--zielen)" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--zielen)",
					"text": "var(--wp--preset--color--tlo)"
				},
				"border": { "radius": "8px" }
			}
		}
	}
}
