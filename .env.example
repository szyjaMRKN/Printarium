# ------------------------------------------------------------------
# Konfiguracja ewidencji działalności nierejestrowanej.
# Skopiuj do pliku .env i uzupełnij. Plik .env nie trafia do repozytorium.
# ------------------------------------------------------------------

# --- domena i HTTPS (Caddy) ---
APP_DOMAIN=ewidencja.mojadomena.pl
ACME_EMAIL=twoj-adres@example.com

# --- środowisko aplikacji ---
APP_ENV=production
APP_DEBUG=0

# Klucz aplikacji. Wygeneruj własny, np.:
#   openssl rand -base64 48
SECRET_KEY=zmien-mnie-na-dlugi-losowy-ciag

# --- użytkownik systemowy dla katalogów danych (id -u / id -g) ---
APP_UID=1000
APP_GID=1000

# --- ciasteczka sesji ---
# W produkcji (HTTPS) zostaw puste — aplikacja sama włączy flagę Secure.
COOKIE_SECURE=
COOKIE_SAMESITE=lax
# Domena ciasteczka (puste = bieżąca domena)
COOKIE_DOMAIN=
# Czas bezczynności sesji w minutach i maksymalny czas życia sesji w godzinach
SESSION_IDLE_MINUTES=720
SESSION_ABSOLUTE_HOURS=168

# --- ochrona logowania ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15

# --- dokumentacja API (Swagger) ---
# W produkcji zwykle 0. Ustaw 1, jeśli chcesz mieć /api/docs.
ENABLE_DOCS=0

# --- konto administratora tworzone przy pierwszym uruchomieniu ---
# Po pierwszym zalogowaniu zmień hasło w aplikacji i wyczyść te zmienne.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=ZmienToHaslo123
ADMIN_EMAIL=

# --- pliki ---
# Twardy limit wielkości żądania po stronie serwera. Limit ustawiany w aplikacji
# (Ustawienia -> Aplikacja) nie może być od niego większy.
MAX_UPLOAD_MB=10

# --- adresy dopuszczone w CORS (tylko development, w produkcji zostaw puste) ---
CORS_ORIGINS=

# --- opcjonalnie: własna czcionka do PDF (musi obsługiwać polskie znaki) ---
PDF_FONT_PATH=
